---
export const prerender = false

import type { Langs } from "@/types"
import { getBlogPost } from "@/lib/sanity/getBlogPosts"
import PostLayout from "@/layouts/PostLayout.astro"
import SanityPortableText from "@/components/sanity/SanityPortableText.astro"

const lang: Langs = "en"
const { slug } = Astro.params

if (!slug) return Astro.redirect("/blog", 302)

const post = await getBlogPost({ slug, lang })

if (!post) return new Response(null, { status: 404 })

const { title, description, categories, image, og_image, readingTime, body, date } = post
---

<PostLayout {title} {description} {slug} {image} og_image={og_image} {categories} {readingTime} {date}>
	<SanityPortableText value={body ?? []} />
</PostLayout>
