---
import { getLangFromUrl, useTranslations } from "@/i18n/utils"
import Typography from "@/components/core/Typography/index.astro"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const paragraph = t("about.paragraph").replace(
	/<strong>(.*?)<\/strong>/g,
	'<span class="mark-text font-bold"><span>$1</span></span>'
)
---

<section
	class="dark:bg-dark relative z-10 flex items-center justify-center bg-white px-5 pt-14 pb-8 md:pt-40 md:pb-24"
>
	<div class="container">
		<Typography
			variant="h2"
			class="text-dark mb-10 leading-[1.2em] font-normal text-pretty dark:text-white"
		>
			<Fragment set:html={paragraph} />
		</Typography>
		<Typography
			variant="h3"
			class="text-dark leading-normal font-normal text-pretty dark:text-white"
		>
			{t("about.cta")}
		</Typography>
	</div>
</section>
